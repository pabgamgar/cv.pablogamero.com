---
import Layout from "../../layouts/Layout.astro";
import ProfessionalSummary from "../../components/ProfessionalSummary.astro";
import WorkExperience from "../../components/WorkExperience.astro";
import Projects from "../../components/Projects.astro";
import Skills from "../../components/Skills.astro";
import Languages from "../../components/Languages.astro";
import Education from "../../components/Education.astro";
import { cv, contact } from "../../data/cv";

const data = cv.es;
---

<Layout
    lang="es"
    title={data.meta.title}
    canon={data.meta.canon}
    alt={data.meta.alt}
    desc={data.meta.desc}
    kw={data.meta.kw}
    subtitle={data.meta.subtitle}
    contact={contact}
>
    <div class="w-full lg:w-2/3 h-fit flex flex-col gap-8">
        <ProfessionalSummary heading={data.labels.professionalSummary} text={data.summary} />
        <WorkExperience heading={data.labels.workExperience} entries={data.workExperience} />
        <Projects heading={data.labels.projects} entries={data.projects} />
    </div>
    <div class="w-full lg:w-1/3 h-fit flex flex-col gap-8">
        <Skills heading={data.labels.skills} categories={data.skills} />
        <Languages heading={data.labels.languages} entries={data.languages} />
        <Education heading={data.labels.education} entries={data.education} />
    </div>
</Layout>
