---
import "../styles/global.css";
import packageJson from "../../package.json";
import type { ContactInfo } from "../data/cv";

interface Props {
  title: string;
  desc: string;
  kw?: string;
  lang?: "en" | "es";
  canon?: string;
  alt?: string;
  subtitle: string;
  contact: ContactInfo;
}
const {
  lang = "en",
  title,
  desc,
  kw,
  canon,
  alt,
  subtitle,
  contact,
} = Astro.props;
const version = packageJson.version;
---

<html lang={lang}>
  <head>
    <!-- COMMON TAGS -->
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="author"
      content="Pablo Gamero García"
    />
    <meta
      name="language"
      content={lang}
    />
    <meta
      name="robots"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex"
    />
    <link
      id="favicon"
      rel="icon"
      type="image/svg+xml"
      href="/favicon.ico"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <meta
      http-equiv="Cache-control"
      content="public"
    />
    <!-- END COMMON TAGS -->

    <title>{title}</title>
    <meta
      name="description"
      content={desc}
    />
    <meta
      name="keywords"
      content={kw}
    />

    <meta
      property="og:title"
      content={title}
    />
    <meta
      property="og:description"
      content={desc}
    />
    <meta
      property="og:image"
      content="/favicon.ico"
    />
    <meta
      property="og:url"
      content={canon}
    />
    <meta
      property="og:type"
      content="website"
    />

    <link
      rel="canonical"
      href={canon}
    />
    <link
      rel="alternate"
      hreflang={lang == "en" ? "es" : "en"}
      href={alt}
    />

    <!-- TWITTER -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={title}
    />
    <meta
      name="twitter:description"
      content={desc}
    />
    <meta
      name="twitter:image"
      content="/favicon.ico"
    />
    <meta
      name="twitter:url"
      content={canon}
    />
  </head>
  <body class="w-full h-fit max-w-5xl px-4 md:px-6 py-8 mx-auto">
    <nav class="w-full mb-4 text-sm flex justify-end items-center gap-3 lang-switch">
      <button
        onclick="window.print()"
        class="print-btn"
        aria-label="Download as PDF"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        PDF
      </button>
      <a
        href="/"
        aria-label="English CV"
        >EN</a
      >
      <span aria-hidden="true">/</span>
      <a
        href="/es"
        aria-label="Spanish CV"
        >ES</a
      >
    </nav>
    <main class="w-full h-full flex flex-col">
      <div
        id="CV"
        class="w-full h-full flex flex-col p-8 md:p-12 border shadow-lg gap-12"
      >
        <div
          class="flex flex-col md:flex-row w-full h-fit gap-8 md:gap-12 md:justify-between lg:justify-normal"
        >
          <div
            id="header"
            class="flex flex-col gap-3 w-full md:w-full lg:w-2/3 h-fit"
          >
            <h1>{contact.name}</h1>
            <p class="text-sm text-neutral-500 text-balance">
              {subtitle}
            </p>
          </div>
          <div
            id="links"
            class="w-full lg:w-1/3 md:w-fit"
          >
            {
              contact.links.map((link) => (
                <p>
                  <a href={link.href}>{link.label}</a>
                </p>
              ))
            }
          </div>
        </div>
        <div class="w-full h-full flex flex-col lg:flex-row gap-12">
          <slot />
        </div>
      </div>
    </main>
  </body>
</html>

<style is:inline>
  h3,
  h4,
  p,
  a {
    font-weight: 300;
  }
  h1,
  h2 {
    color: #3e7baf;
  }
  h1 {
    font-size: 1.875rem /* 30px */;
    line-height: 2.25rem /* 36px */;
    font-weight: bold;
  }
  h2 {
    font-size: 1.1rem /* 20px */;
    line-height: 1.75rem /* 28px */;
    font-weight: bold;
  }
  h3 {
    font-size: 1rem /* 18px */;
    line-height: 1.75rem /* 28px */;
  }
  ul {
    padding-left: 48px;
    margin: 0;
  }
  li {
    padding: 0;
    margin: 0;
    list-style: square !important;
    list-style-position: outside !important;
    font-weight: 300;
  }

  span.date {
    font-size: x-small;
    color: grey;
    padding-left: 12px;
    font-weight: normal;
  }

  .bold {
    font-weight: 500;
  }
  .sm-txt {
    font-size: 8px;
  }

  @media (max-width: 767px) {
    #links.inline-links p {
      display: inline;
    }
  }

  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 1px solid #3e7baf;
    border-radius: 4px;
    background: none;
    color: #3e7baf;
    font-size: 0.875rem;
    font-weight: 400;
    cursor: pointer;
    margin-right: auto;
  }
  .print-btn:hover {
    background: #3e7baf;
    color: white;
  }

  @page {
    margin: 0;
  }
  @media print {
    body {
      max-width: none;
      margin: 0;
      padding: 0;
    }
    .lang-switch {
      display: none !important;
    }
    #CV {
      padding: 1.5cm 2cm;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
      border: none !important;
      box-shadow: none !important;
      gap: 2rem;
    }
    #links p {
      display: inline;
    }
    #links p:not(:last-child)::after {
      content: " · ";
    }
    #links .sep {
      display: none;
    }
    h2,
    h3 {
      break-after: avoid;
    }
    #work-exp > div,
    #projects > div,
    #education > div,
    #skills > div {
      break-inside: avoid;
    }
  }
</style>

<script>
  function updateLinkSeps() {
    const links = document.getElementById('links');
    if (!links) return;
    links.querySelectorAll('.sep').forEach((s) => s.remove());
    links.classList.add('inline-links');
    const items = links.querySelectorAll('p');
    for (let i = 0; i < items.length - 1; i++) {
      const a = items[i].getBoundingClientRect();
      const b = items[i + 1].getBoundingClientRect();
      if (Math.abs(a.top - b.top) < 2) {
        const sep = document.createElement('span');
        sep.className = 'sep';
        sep.textContent = ' · ';
        items[i].after(sep);
      }
    }
  }
  updateLinkSeps();
  window.addEventListener('resize', updateLinkSeps);

</script>
